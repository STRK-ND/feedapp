# =============================================================================
# CI/CD Environment Variables for Curated Feeds
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or .env with real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# CircleCI Environment Variables (set in Project Settings)
# https://app.circleci.com/settings/project/github/STRK-ND/feedapp/environment-variables
# -----------------------------------------------------------------------------

# Required for build-release job — Shorebird authentication
# Get from: Run `shorebird login` locally, then `shorebird token`
SHOREBIRD_TOKEN=

# Required for GitHub Release creation (auto-set by CircleCI, but kept here for reference)
# GH_TOKEN is auto-provided when using GitHub context
# GH_TOKEN: auto-provided by CircleCI

# -----------------------------------------------------------------------------
# App Environment
# -----------------------------------------------------------------------------

# Set to CI in all CI runs — enables test mocks, skips Firebase init
FLUTTER_ENV=CI

# -----------------------------------------------------------------------
# Local Development (not needed for CI)
# -----------------------------------------------------------------------
# SENTRY_DSN=  # Set via --dart-define in local builds
# FLUTTER_ENV=development