<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window.
     The ground is @color/launch_background (values/ + values-night/) rather
     than a literal or ?android:colorBackground, so the hand-off to the
     Flutter splash is a same-colour swap instead of a white flash.
     launch_image is generated by tool/generate_brand_assets.py in five
     density buckets so the logo measures 96dp on every screen — matching
     AppLogo's default size, so nothing jumps at the hand-off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:src="@drawable/launch_image"
            android:gravity="center" />
    </item>
</layer-list>
