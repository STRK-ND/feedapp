# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing config & keystore (never commit)
**/android/key.properties
**/android/app/upload-keystore.jks
**/android/app/*.keystore
**/android/app/*.jks

# Planning directory (not tracked in git per configuration)
.planning/
.openspec/

# Local secret handoff for CircleCI env vars (never commit)
env.txt

# Worktrees for isolated feature development
.worktrees/

# Wrangler / Cloudflare Workers cache and build artifacts
workers/.wrangler/

# Kotlin Gradle plugin persistent data
.kotlin/

# Platform-specific directories (Android only build)
web/
linux/
windows/
macos/
ios/

# Tool directories
.gstack/
.kiro/
openspec/

_build.txt
_curate_ss.png
_ss*.png

# --- App Store / Play screenshot editor (Next.js scaffold in this repo) ------
# The editor writes these; they are reproducible, so keep them out of git.
node_modules
.next
out
*.tsbuildinfo
next-env.d.ts
.env*.local

# Uploaded screenshots belong to the generated project: commit them alongside
# app-store-screenshots.json so decks remain reproducible after cloning.

# Fonts imported from the editor toolbar are user assets too (and font licences
# often forbid redistributing them), so keep them out of the template as well.
public/fonts/imported/*
!public/fonts/imported/.gitkeep

# Tester Army output
.e2e/
